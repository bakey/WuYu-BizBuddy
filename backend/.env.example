# ===== 应用 =====
APP_ENV=development
LOG_LEVEL=info

# ===== 业务库（skill 配置 / 日志 / 引用 / 反馈）=====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizbuddy_rag

# ===== OpenAI 协议大模型（问答 / 旧 RAG demo 嵌入）=====
OPENAI_API_KEY=
# 如使用自建/兼容网关，填其 base_url，否则留空走官方。
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ===== 通用 RAG demo =====
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ===== 行业知识 - 全文检索版 =====
INDUSTRY_DEFAULT_TOP_K=5
INDUSTRY_MAX_TOP_K=20
INDUSTRY_FULLTEXT_CONFIG=chinese_zh
INDUSTRY_DEFAULT_MAX_CONTEXT_CHARS=6000

# ===== 行业知识 - 向量检索版（gufei_vec + bge-m3）=====
# 向量库连接串；为空表示未配置，向量检索会报错（全文检索不受影响）。
# 部署机示例（密码见 /root/pg_gufei_creds.txt）：
# GUFEI_VEC_URL=postgresql://postgres:****@127.0.0.1:5440/gufei_vec
GUFEI_VEC_URL=
# 本地 bge-m3 模型路径，必须与入库时一致（1024 维）。
BGE_M3_MODEL_PATH=/data/models/bge-m3_20250912_235519m
# 运行设备：cpu 或 cuda。
BGE_M3_DEVICE=cpu
# IVFFlat probes：5≈20s/85%，10≈47s/90%，20≈77s/95%（务必配合 subdir 过滤）。
INDUSTRY_VECTOR_PROBES=5
# cosine 相似度阈值，低于该值的片段被过滤；0 表示不过滤。
INDUSTRY_VECTOR_SCORE_THRESHOLD=0.0
# 召回片段最小正文字符数：过滤"只有标题/极短碎片"的 chunk；0 表示不过滤。
INDUSTRY_VECTOR_MIN_CHUNK_CHARS=50
# 同一来源文档最多保留的片段数：避免一篇文档的碎片占满 top_k；0 表示不限。
INDUSTRY_VECTOR_MAX_PER_SOURCE=3
# 内容近重去重：正文规范化前缀相同则视为同一篇（消除同文异源重复）；0 表示不做。
INDUSTRY_VECTOR_DEDUPE_CONTENT_PREFIX=80

# ===== 行业知识 - 重排（rerank）=====
# bge-reranker 模型路径；建议指向 Linux 本地路径，例如 /data/models/bge-reranker-v2-m3。
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
# 运行设备：cpu 或 cuda。
BGE_RERANKER_DEVICE=cpu
# 是否默认启用重排（可被 skill 级配置覆盖）；配好模型后再设为 true。
INDUSTRY_RERANK_ENABLED=false
# 重排前向量多召回的候选数量，最终再截断到 top_k。
INDUSTRY_RERANK_OVER_FETCH_K=30
